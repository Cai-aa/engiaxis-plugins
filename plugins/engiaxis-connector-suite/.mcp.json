{
  "mcpServers": {
    "engiaxis-connector-suite": {
      "command": "node",
      "args": [
        "./runtime/connector.mjs",
        "mcp",
        "--edition",
        "suite"
      ],
      "cwd": ".",
      "env": {
        "ENGIAXIS_BUNDLED_MCP_DIR": "./bundled-mcp",
        "ENGIAXIS_PUBLIC_KEY_PATH": "./runtime/public-key.pem"
      }
    }
  }
}
